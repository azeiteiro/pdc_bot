# ================================================
# Telegram Bot Configuration
# ================================================

# Telegram Bot Tokens
# Get these from @BotFather on Telegram
BOT_DEVELOPMENT_TOKEN=
BOT_PRODUCTION_TOKEN=

# Environment (development | production)
NODE_ENV=development

# Group Chat ID where the bot will operate
# Use /getid command or check Telegram group info
GROUP_CHAT_ID=

# Onboarding Google Sheet ID for new user tracking
# Get this from the onboarding spreadsheet URL
ONBOARDING_SHEET_ID=

# Offboarding Google Sheet ID (optional — only needed for /offboarding2 and /offboarding3)
# Tab name inside GOOGLE_SPREADSHEET_ID. Columns: A=user_id, B=amount (positive=receives, negative=owes)
OFFBOARDING_SHEET_ID=

# Admin User IDs (JSON array of numbers)
# Example: [123456789, 987654321]
# These users will have access to admin commands
ADMIN_IDS=[]

# MBWay phone number shown in payment instructions
MBWAY_NUMBER=+351XXXXXXXXX

# ================================================
# Google API Configuration
# ================================================

# Google OAuth2 Credentials
# Create these at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# ================================================
# Google Photos Configuration
# ================================================

# Enable/disable photo uploads to Google Photos
UPLOAD_TO_GPHOTOS=true

# Google Photos Album ID
# Use /createalbum command or get from album URL
ALBUM_ID=

# Public album URL for sharing
# Get this from Google Photos album share settings
ALBUM_URL=

# Description/tags to add to uploaded photos
PHOTO_DESCRIPTION="#festival"

# ================================================
# Google Sheets Configuration
# ================================================

# Google Spreadsheet ID (from the spreadsheet URL)
# Example: https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=

# Sheet ID (gid parameter from the URL)
# Example: https://docs.google.com/spreadsheets/d/.../edit#gid=YOUR_SHEET_ID
GOOGLE_SHEET_ID=

# ================================================
# Weather API Configuration
# ================================================

# AccuWeather API Key
# Get free API key at https://developer.accuweather.com/
ACCUWEATHER_API_KEY=

# ================================================
# Legacy Configuration
# ================================================

# Base path for file operations (legacy, may not be needed)
BASE_PATH=../..