# ================================================
# Telegram Bot Configuration
# ================================================

# Telegram Bot Tokens
# Get these from @BotFather on Telegram
BOT_DEVELOPMENT_TOKEN=
BOT_PRODUCTION_TOKEN=

# Environment (development | production)
NODE_ENV=development

# Group Chat ID where the bot will operate
# Use /getid command or check Telegram group info
GROUP_CHAT_ID=

# Onboarding Google Spreadsheet ID (from the spreadsheet URL)
# Example: https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit
ONBOARDING_SPREADSHEET_ID=

# Onboarding Google Sheet tab name for new user tracking
ONBOARDING_SHEET_ID=

# Offboarding Google Spreadsheet ID (optional — only needed for /offboarding2 and /offboarding3)
# Example: https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit
OFFBOARDING_SPREADSHEET_ID=

# Offboarding Google Sheet tab name (optional — only needed for /offboarding2 and /offboarding3)
# Tab name inside OFFBOARDING_SPREADSHEET_ID. Columns: A=user_id, B=amount (positive=receives, negative=owes)
OFFBOARDING_SHEET_ID=

# Admin User IDs (JSON array of numbers)
# Example: [123456789, 987654321]
# These users will have access to admin commands
ADMIN_IDS=[]

# MBWay phone number shown in payment instructions
MBWAY_NUMBER=+351XXXXXXXXX

# ================================================
# Google API Configuration
# ================================================

# Google OAuth2 Credentials
# Create these at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# ================================================
# Google Photos Configuration
# ================================================

# Enable/disable photo uploads to Google Photos
UPLOAD_TO_GPHOTOS=true

# Google Photos Album ID
# Use /createalbum command or get from album URL
ALBUM_ID=

# Public album URL for sharing
# Get this from Google Photos album share settings
ALBUM_URL=

# Description/tags to add to uploaded photos
PHOTO_DESCRIPTION="#festival"

# ================================================
# Google Sheets Configuration
# ================================================

# Expenses sheet tab name inside the onboarding spreadsheet (e.g. Despesas)
EXPENSES_SHEET_ID=

# ================================================
# Weather API Configuration
# ================================================

# IPMA Location ID (Portuguese weather service — free, no API key required)
# Find your location ID at: https://api.ipma.pt/open-data/distrits-islands.json
# Note: use the nearest supported city — not all localities have coverage.
# Example: 1160900 (Viana do Castelo, nearest city to Paredes de Coura)
IPMA_LOCATION_ID=

# ================================================
# Legacy Configuration
# ================================================

# Base path for file operations (legacy, may not be needed)
BASE_PATH=../..