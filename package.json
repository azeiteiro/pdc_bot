{
  "name": "telegram_bot",
  "version": "1.0.0",
  "description": "telegram festival bot",
  "main": "app.ts",
  "private": true,
  "engines": {
    "node": ">=18.x"
  },
  "author": {
    "name": "Daniel Azeiteiro",
    "email": "daniel.azeiteiro@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/azeiteiro/telegram_bot.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "( tsc -w & ) && nodemon dist/app.js",
    "build": "tsc",
    "test": "jest --coverage",
    "format": "prettier --write src/**/*",
    "lint": "eslint 'src/**/*.{js,ts}'",
    "lint:fix": "yarn lint --fix"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "@types/node": "^20.14.11",
    "@types/node-schedule": "^2.1.7",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.1",
    "eslint": "^9.7.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-n": "^17.9.0 ",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-promise": "^6.6.0",
    "globals": "^15.8.0",
    "googleapis": "^140.0.1",
    "http-terminator": "^3.2.0",
    "node-schedule": "^2.1.1",
    "nodemon": "^3.1.4",
    "open": "8.4.2",
    "prettier": "^3.3.3",
    "prettier-eslint": "^16.3.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.6.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.0",
    "winston": "^3.13.1",
    "yarn-upgrade-all": "^0.7.2"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "googleapis-common": "^7.2.0",
    "telegraf": "^4.16.3"
  },
  "packageManager": "yarn@1.22.22"
}
