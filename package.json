{
  "name": "clean_bot",
  "version": "1.0.0",
  "description": "telegram test bot",
  "main": "app.ts",
  "private": true,
  "engines": {
    "node": ">=16.x"
  },
  "author": {
    "name": "Daniel Azeiteiro",
    "email": "daniel.azeiteiro@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/azeiteiro/telegram_bot.git"
  },
  "license": "MIT",
  "scripts": {
    "start": "ts-node --files src/app.ts",
    "watch": "nodemon",
    "dev": "( tsc -w & ) && nodemon dist/app.js",
    "build": "tsc src/app.ts --target esnext --outfile index.js --module amd",
    "test": "jest --coverage",
    "eject": "eject",
    "format": "prettier --write src/**/*",
    "lint": "eslint --ext .tsx,.ts 'src/**/*.{tsx,ts}'",
    "lint:fix": "yarn lint --fix",
    "analyzeBundles": "yarn run build --analyzeBundles --watch"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "type": "commonjs",
  "devDependencies": {
    "@babel/preset-typescript": "^7.21.0",
    "@types/node": "^18.14.1",
    "@types/node-schedule": "^2.1.0",
    "@typescript-eslint/eslint-plugin": "^5.53.0",
    "@typescript-eslint/parser": "^5.53.0",
    "eslint": "^8.34.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-css-modules": "^2.11.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "^7.32.2",
    "googleapis": "^111.0.0",
    "http-terminator": "^3.2.0",
    "node-schedule": "^2.1.1",
    "nodemon": "^2.0.16",
    "open": "^8.4.2",
    "prettier": "^2.8.4",
    "prettier-eslint": "^15.0.0",
    "prettier-eslint-cli": "^7.0.0",
    "ts-node": "^10.7.0",
    "tslib": "^2.5.0",
    "typescript": "^4.9.5",
    "winston": "^3.7.2",
    "yarn-upgrade-all": "^0.7.2"
  },
  "dependencies": {
    "axios": "^1.3.4",
    "dotenv": "^16.0.1",
    "googleapis-common": "^6.0.0",
    "telegraf": "^4.12.2"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,json}": [
      "yarn run --silent lint:fix",
      "prettier --config .prettierrc --write"
    ],
    "src/**/*.{css}": [
      "stylelint --config=.stylelintrc --fix",
      "prettier --config .prettierrc --write"
    ]
  }
}
