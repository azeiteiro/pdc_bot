{
  "name": "clean_bot",
  "version": "1.0.0",
  "description": "telegram test bot",
  "main": "app.ts",
  "private": true,
  "engines": {
    "node": ">=18.x"
  },
  "author": {
    "name": "Daniel Azeiteiro",
    "email": "daniel.azeiteiro@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/azeiteiro/telegram_bot.git"
  },
  "license": "MIT",
  "scripts": {
    "start": "ts-node --files src/app.ts",
    "watch": "nodemon",
    "dev": "( tsc -w & ) && nodemon dist/app.js",
    "build": "tsc src/app.ts --target esnext --outfile index.js --module amd",
    "test": "jest --coverage",
    "eject": "eject",
    "format": "prettier --write src/**/*",
    "lint": "eslint 'src/**/*.{js,ts}'",
    "lint:fix": "yarn lint --fix"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^20.7.2",
    "@types/node-schedule": "^2.1.1",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.3",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-css-modules": "^2.11.4",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prettier": "^5.0.0",
    "googleapis": "^126.0.1",
    "http-terminator": "^3.2.0",
    "node-schedule": "^2.1.1",
    "nodemon": "^3.0.1",
    "open": "8.4.2",
    "prettier": "^3.0.3",
    "prettier-eslint": "^15.0.1",
    "prettier-eslint-cli": "^7.1.0",
    "ts-node": "^10.9.1",
    "tslib": "^2.6.2",
    "typescript": "^5.2.2",
    "winston": "^3.10.0",
    "yarn-upgrade-all": "^0.7.2"
  },
  "dependencies": {
    "axios": "^1.5.1",
    "dotenv": "^16.3.1",
    "googleapis-common": "^7.0.0",
    "telegraf": "^4.14.0"
  }
}
