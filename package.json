{
  "name": "telegram_bot",
  "version": "1.0.1",
  "description": "telegram festival bot",
  "exports": "./app.js",
  "private": true,
  "engines": {
    "node": ">=24.x"
  },
  "author": {
    "name": "Daniel Azeiteiro",
    "email": "daniel.azeiteiro@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/azeiteiro/telegram_bot.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "tsx --watch src/app.ts",
    "clean": "rimraf dist",
    "build": "yarn clean && tsc && cp -r src/resources dist/resources",
    "start": "node dist/app.js",
    "test": "jest --coverage",
    "format": "prettier --write src/**/*",
    "format:check": "prettier --check src/**/*",
    "lint": "eslint 'src/**/*.{js,ts}'",
    "lint:fix": "yarn lint --fix",
    "prepare": "husky"
  },
  "type": "module",
  "resolutions": {
    "minimatch": "^9.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.4.0",
    "@types/node-schedule": "^2.1.8",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-promise": "^7.2.1",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.3",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.1",
    "prettier-eslint": "^16.4.2",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  },
  "dependencies": {
    "@googleapis/sheets": "^10.0.0",
    "axios": "^1.13.6",
    "dotenv": "^17.3.1",
    "google-auth-library": "^10.6.1",
    "http-terminator": "^3.2.0",
    "node-schedule": "^2.1.1",
    "open": "^11.0.0",
    "telegraf": "^4.16.3",
    "winston": "^3.19.0"
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "packageManager": "yarn@1.22.22"
}
