{
  "name": "telegram_bot",
  "version": "1.0.1",
  "description": "telegram festival bot",
  "exports": "./app.js",
  "private": true,
  "engines": {
    "node": ">=20.x"
  },
  "author": {
    "name": "Daniel Azeiteiro",
    "email": "daniel.azeiteiro@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/azeiteiro/telegram_bot.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"tsx src/app.ts\"",
    "clean": "rimraf dist",
    "build": "yarn clean && tsc",
    "start": "node dist/app.js",
    "test": "jest --coverage",
    "format": "prettier --write src/**/*",
    "lint": "eslint 'src/**/*.{js,ts}'",
    "lint:fix": "yarn lint --fix"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.0.14",
    "@types/node-schedule": "^2.1.8",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.44.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.21.0",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-promise": "^7.2.1",
    "globals": "^16.3.0",
    "googleapis": "^160.0.0",
    "http-terminator": "^3.2.0",
    "node-schedule": "^2.1.1",
    "nodemon": "^3.1.10",
    "open": "^10.2.0",
    "prettier": "^3.6.2",
    "prettier-eslint": "^16.4.2",
    "tslib": "^2.8.1",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.44.1",
    "winston": "^3.17.0"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "dotenv": "^17.2.2",
    "googleapis-common": "^8.0.0",
    "telegraf": "^4.16.3"
  },
  "packageManager": "yarn@1.22.22"
}
