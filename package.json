{
  "name": "telegram_bot",
  "version": "1.0.1",
  "description": "telegram festival bot",
  "exports": "./app.js",
  "private": true,
  "engines": {
    "node": ">=24.x"
  },
  "author": {
    "name": "Daniel Azeiteiro",
    "email": "daniel.azeiteiro@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/azeiteiro/telegram_bot.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "tsx --watch --env-file=.env src/app.ts",
    "build": "tsup && cp -r src/resources dist/ && cp -r src/locales dist/",
    "start": "node --env-file=.env dist/app.js",
    "test": "LOG_LEVEL=silent NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest --coverage --silent",
    "format": "prettier --write src/**/*",
    "format:check": "prettier --check src/**/*",
    "lint": "eslint 'src/**/*.{js,ts}'",
    "lint:fix": "pnpm lint --fix",
    "prepare": "husky"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/hydrate": "^1.6.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-promise": "^7.3.0",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "prettier-eslint": "^16.4.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1"
  },
  "dependencies": {
    "@googleapis/sheets": "^13.0.1",
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/i18n": "^1.1.2",
    "@grammyjs/runner": "^2.0.3",
    "bree": "^9.2.9",
    "better-sqlite3": "^11.0.0",
    "google-auth-library": "^10.6.2",
    "grammy": "^1.42.0",
    "http-terminator": "^3.2.0",
    "open": "^11.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1"
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
