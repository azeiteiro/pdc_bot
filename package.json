{
  "name": "clean_bot",
  "version": "1.0.0",
  "description": "telegram test bot",
  "main": "app.ts",
  "private": true,
  "author": {
    "name": "Daniel Azeiteiro",
    "email": "daniel.azeiteiro@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/azeiteiro/telegram_bot.git"
  },
  "license": "MIT",
  "scripts": {
    "start": "ts-node src/app.ts",
    "watch": "nodemon",
    "dev": "( tsc -w & ) && nodemon dist/app.js",
    "build": "react-scripts build",
    "test": "jest --coverage",
    "eject": "react-scripts eject",
    "format": "prettier --write src/**/*",
    "lint": "yarn lint:js && yarn lint:css",
    "lint:js": "eslint --ext .tsx,.ts 'src/**/*.{tsx,ts}'",
    "lint:css": "stylelint --config=.stylelintrc '**/*.css'",
    "lint:fix": "yarn lint:js --fix && yarn lint:css --fix",
    "analyzeBundles": "yarn run build --analyzeBundles --watch"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "type": "commonjs",
  "devDependencies": {
    "@babel/preset-react": "^7.14.5",
    "@babel/preset-typescript": "^7.15.0",
    "@types/node": "^16.6.1",
    "@types/node-schedule": "^1.3.2",
    "@types/react": "^17.0.18",
    "@types/react-dom": "^17.0.9",
    "@typescript-eslint/eslint-plugin": "^5.3.1",
    "@typescript-eslint/parser": "^5.3.1",
    "eslint": "^8.2.0",
    "eslint-config-airbnb": "^18.2.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-css-modules": "^2.11.0",
    "eslint-plugin-import": "^2.24.0",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "^7.24.0",
    "eslint-plugin-react-hooks": "^4.2.0",
    "googleapis": "^91.0.0",
    "http-terminator": "^3.0.0",
    "node-schedule": "^2.0.0",
    "nodemon": "^2.0.12",
    "open": "^8.2.1",
    "prettier": "^2.3.2",
    "prettier-eslint": "^13.0.0",
    "prettier-eslint-cli": "^5.0.1",
    "ts-node": "^10.2.0",
    "tslib": "^2.3.1",
    "typescript": "^4.3.5",
    "winston": "^3.3.3"
  },
  "dependencies": {
    "axios": "^0.24.0",
    "dotenv": "^10.0.0",
    "googlephotos": "^0.3.4",
    "telegraf": "^4.4.1"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,json}": [
      "yarn run --silent lint:fix",
      "prettier --config .prettierrc --write"
    ],
    "src/**/*.{css}": [
      "stylelint --config=.stylelintrc --fix",
      "prettier --config .prettierrc --write"
    ]
  }
}
