{
  "name": "telegram_bot",
  "version": "1.0.1",
  "description": "telegram festival bot",
  "exports": "./app.js",
  "private": true,
  "engines": {
    "node": ">=24.x"
  },
  "author": {
    "name": "Daniel Azeiteiro",
    "email": "daniel.azeiteiro@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/azeiteiro/pdc_bot.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "tsx --watch --env-file=.env src/app.ts",
    "build": "tsup && cp -r src/resources dist/ && cp -r src/locales dist/",
    "start": "node --env-file=.env dist/app.js",
    "test": "LOG_LEVEL=silent GOOGLE_CLIENT_ID=test-id GOOGLE_CLIENT_SECRET=test-secret GOOGLE_REDIRECT_URL=http://localhost NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest --coverage --silent",
    "format": "prettier --write src/**/*",
    "format:check": "prettier --check src/**/*",
    "lint": "eslint 'src/**/*.{js,ts}'",
    "lint:fix": "pnpm lint --fix",
    "prepare": "husky"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.2.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "@googleapis/sheets": "^13.0.2",
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/hydrate": "^1.7.0",
    "@grammyjs/i18n": "^1.1.2",
    "@grammyjs/runner": "^2.0.3",
    "better-sqlite3": "^13.0.1",
    "bree": "^9.2.9",
    "chrono-node": "^2.10.1",
    "google-auth-library": "10.9.1",
    "grammy": "^1.45.1",
    "http-terminator": "^3.2.0",
    "open": "^11.0.0",
    "pino": "^10.3.1"
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@11.17.0"
}
